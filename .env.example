# ==============================================================================
# GITHUB CREDENTIALS (Required)
# ==============================================================================

# Personal Access Token (Classic: repo scope OR Fine-Grained: Contents Read & Write)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# GitHub username or organization where the repo lives
GITHUB_OWNER=divya8050

# Track 1: JavaScript Practice Repository (e.g. javascript)
GITHUB_REPO=javascript

# Track 2: HTML & CSS Practice Repository (e.g. html-css)
HTML_CSS_REPO=html-css

# Branch to commit to (default is main)
GITHUB_BRANCH=main

# ==============================================================================
# COMMIT ATTRIBUTION (CRUCIAL FOR GREEN CONTRIBUTION STREAK!)
# ==============================================================================

# Author name shown on the commit
GIT_AUTHOR_NAME=divya adsare

# CRITICAL: This MUST match the primary email or noreply email on your GitHub account!
# If this does not match, GitHub will not color your green streak squares.
# Find yours at: https://github.com/settings/emails
GIT_AUTHOR_EMAIL=divyaadsare@gmail.com

# ==============================================================================
# VERCEL CRON SECURITY & FREQUENCY
# ==============================================================================

# A random secure string to protect your /api/cron endpoint from unauthorized callers.
CRON_SECRET=GitStreak_2026_9xK82mP7

# Number of progressive commits pushed each day per track (e.g. 2 or 3)
COMMITS_PER_DAY=3

# Start date of the 180-day mastery journey
STREAK_START_DATE=2026-09-28

# ==============================================================================
# AI & PREFERENCES
# ==============================================================================

# Google Gemini API key to generate dynamic, fresh code problems each day.
# Free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Target programming language
PREFERRED_LANGUAGE=javascript
